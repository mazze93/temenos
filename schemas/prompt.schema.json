{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mazze93/temenos/schemas/prompt.schema.json",
  "title": "Temenos Prompt Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","title","version","status","purpose","scope","inputs","outputs","security_considerations","failure_modes","evaluation","body"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
    "title": {"type":"string","minLength":1},
    "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum":["draft","experimental","stable","deprecated"]},
    "purpose": {"type":"string","minLength":1},
    "scope": {"type":"string","minLength":1},
    "inputs": {"type":"array","items":{"type":"string"}},
    "outputs": {"type":"array","items":{"type":"string"}},
    "dependencies": {"type":"array","items":{"type":"string"},"default":[]},
    "model_assumptions": {"type":"array","items":{"type":"string"},"default":[]},
    "security_considerations": {"type":"array","items":{"type":"string"}},
    "failure_modes": {"type":"array","items":{"type":"string"}},
    "evaluation": {"type":"array","items":{"type":"string"}},
    "authors": {"type":"array","items":{"type":"string"},"default":[]},
    "created": {"type":"string","format":"date"},
    "updated": {"type":"string","format":"date"},
    "license": {"type":"string","default":"MIT"},
    "body": {"type":"string","minLength":1}
  }
}
