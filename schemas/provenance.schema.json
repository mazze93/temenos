{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mazze93/temenos/schemas/provenance.schema.json",
  "title": "Temenos Provenance Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id","artifact_type","workflow_version","inputs","transformations","created_at"],
  "properties": {
    "artifact_id": {"type":"string","minLength":1},
    "artifact_type": {"type":"string","minLength":1},
    "workflow_version": {"type":"string","minLength":1},
    "model": {
      "type":["object","null"],
      "properties":{
        "provider":{"type":"string"},
        "name":{"type":"string"},
        "version":{"type":"string"},
        "parameters":{"type":"object"}
      },
      "additionalProperties": true
    },
    "inputs": {
      "type":"array",
      "items":{
        "type":"object",
        "required":["id","sha256"],
        "properties":{
          "id":{"type":"string"},
          "uri":{"type":"string"},
          "sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "tools":{"type":"array","items":{"type":"object"},"default":[]},
    "transformations":{"type":"array","items":{"type":"string"}},
    "evaluations":{"type":"array","items":{"type":"string"},"default":[]},
    "human_edits":{"type":"array","items":{"type":"string"},"default":[]},
    "created_at":{"type":"string","format":"date-time"}
  }
}
