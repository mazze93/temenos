{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mazze93/temenos/schemas/evaluation.schema.json",
  "title": "Temenos Evaluation Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","subject","dimensions","method","result"],
  "properties": {
    "id":{"type":"string","minLength":1},
    "subject":{"type":"string","minLength":1},
    "dimensions":{"type":"array","minItems":1,"items":{"type":"string"}},
    "method":{"enum":["deterministic","behavioral","model_based","human_review"]},
    "fixtures":{"type":"array","items":{"type":"string"},"default":[]},
    "result":{"enum":["pass","fail","inconclusive"]},
    "evidence":{"type":"array","items":{"type":"string"},"default":[]},
    "notes":{"type":"string","default":""}
  }
}
