# Temenos runtime. Copy to .env (git-ignored) or export into the environment.
# Tokens never live in committed config.

# stratum worker base URL (wrangler dev locally, deployed worker in production)
TEMENOS_STRATUM_URL=http://127.0.0.1:8787

# bearer token for stratum writes (non-demo/playground logs are auth-gated)
STRATUM_TOKEN=

# the ledger log decisions are appended to
TEMENOS_LOG_ID=temenos

# shadow (record, block nothing) | enforce (a `stop` verdict blocks)
TEMENOS_MODE=shadow

# optional: path to a config file overriding policy/policy.yaml
# TEMENOS_CONFIG=